# ─── Runtime ───
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
TRUST_PROXY=1
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173

# ─── Database (Neon Cloud Postgres / Neon Local proxy) ───
# Production/cloud: pooled connection for the app
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require
# Direct (unpooled) connection for Drizzle Kit migrations
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require
# Set only when running behind the Neon Local docker proxy (compose.yaml sets this automatically)
NEON_PROXY_URL=

# ─── Neon Local (docker compose) ───
NEON_API_KEY=
NEON_PROJECT_ID=
PARENT_BRANCH_ID=
BRANCH_ID=
DELETE_BRANCH=true

# ─── Auth / JWT ───
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ─── Cookies ───
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
COOKIE_SAMESITE=lax

# ─── ArcJet security ───
# Leave empty to run ArcJet in DRY_RUN/local observation mode (dev/test safe).
ARCJET_KEY=
ARCJET_ENV=development

# ─── Logging ───
LOG_LEVEL=debug
